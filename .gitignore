# Environments
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.env

# Data: raw datasets are never committed (licence / size); processed data is regenerated.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model binaries are regenerated by `make forecast`.
models/*
!models/.gitkeep

# Synthetic smoke-run outputs
reports/metrics/synthetic/
reports/figures/synthetic/
reports/*synthetic*.md
mlruns/
runs/
.DS_Store
